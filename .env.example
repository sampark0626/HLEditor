# HLEditor 환경 설정 예시
# 이 파일을 복사하여 .env 로 저장 후 값을 채워주세요.
# cp .env.example .env

# ── Gemini API (하이라이트 판별 비전 AI) ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# 판독에 사용할 모델 설정 (기본값: gemini-2.5-flash)
# 더 높은 정확도를 원한다면 gemini-2.5-pro 모델 사용을 권장합니다.
# GEMINI_MODEL=gemini-2.5-pro

# 한 구간에서 판독을 위해 Gemini로 보낼 최대 이미지(프레임) 개수 (기본값: 12)
# 개수가 많을수록 정확도가 올라가지만 토큰 비용이 늘어납니다.
# MAX_FRAMES=12

# ── YouTube Upload ─────────────────────────────────────────────────────────
# Google Cloud Console에서 OAuth 2.0 클라이언트 ID (데스크톱 앱) 생성 후
# client_secrets.json 파일을 이 폴더에 저장하세요.
# client_secrets.json 경로 (기본: 현재 폴더의 client_secrets.json)
# YOUTUBE_CLIENT_SECRETS=C:\path\to\client_secrets.json

# 업로드 공개 범위: public | unlisted | private (기본: public)
YOUTUBE_PRIVACY=public

# ── BAND API ───────────────────────────────────────────────────────────────
# https://developers.band.us 에서 앱 등록 후 발급
BAND_CLIENT_ID=your_band_client_id_here
BAND_CLIENT_SECRET=your_band_client_secret_here

# 기본 게시 대상 밴드 키 (UI에서도 선택 가능)
# 밴드 앱 > 설정 > 밴드 관리 > 밴드 Key 에서 확인
# BAND_TARGET_KEY=your_band_key_here

# ── Dot Play (FM 스타일 2D 버드뷰 변환) ─────────────────────────────────────
# 선수/피치 키포인트 검출에 roboflow 호스팅 모델을 쓴다. 무료 계정으로
# https://app.roboflow.com 가입 후 Settings > API Keys 에서 발급.
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# 사용할 roboflow 모델 ID (기본값이 이미 공개 Universe 모델로 설정되어 있어
# 보통 건드릴 필요 없음)
# DOTPLAY_PLAYER_MODEL_ID=football-players-detection-3zvbc/11
# DOTPLAY_FIELD_MODEL_ID=football-field-detection-f07vi/14

# ── 앱 공통 설정 (선택) ─────────────────────────────────────────────────────
# 영상 워터마크·YouTube 제목 기본값 (기본: "한울타리 FC 경기영상")
# DEFAULT_TITLE=우리 팀 경기영상

# 웹 서버 포트 (기본: 5000). 바꾸면 YouTube/BAND OAuth 리디렉션 URI도
# 함께 재등록해야 합니다.
# HL_PORT=5000
